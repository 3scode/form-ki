# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Opsional: belum dipakai kode karena akses data hanya dari server.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Wajib, server-only. Jangan pernah diberi prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (Dashboard → Product Environment Credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sesi & akun admin
SESSION_SECRET=ganti-dengan-string-acak-panjang
ADMIN_EMAIL=admin@sekolah.sch.id
ADMIN_PASSWORD=ganti-password-ini

# URL publik aplikasi (isi QR Code), tanpa slash di akhir
NEXT_PUBLIC_APP_URL=http://localhost:3000
